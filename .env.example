# File Organizer Agent — copie para .env e ajuste.
# Variáveis de ambiente reais sempre vencem o que estiver aqui.
# Toda chave abaixo corresponde a um campo do dataclass organizer.config.Config.

# --- raízes (TUDO relocável: é isto que torna o sandbox de teste possível) ---
# 5 raízes de destino, uma por pasta padrão do Windows — nada vai para uma
# árvore "Organizado" à parte. DOWNLOADS_DIR é sempre só origem, nunca destino.
#
# ATENÇÃO: se o OneDrive estiver com Backup de Pastas ligado, Documents /
# Pictures / Desktop são redirecionados para dentro do OneDrive e com NOME
# LOCALIZADO (ex: C:\Users\voce\OneDrive\Documentos). A pasta antiga
# C:\Users\voce\Documents pode continuar existindo vazia — não use essa.
# Confira o caminho real no registro:
#   reg query "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders"
DOWNLOADS_DIR=C:\Users\SEU_USUARIO\Downloads
DOCUMENTS_ROOT=C:\Users\SEU_USUARIO\Documents
PICTURES_ROOT=C:\Users\SEU_USUARIO\Pictures
VIDEOS_ROOT=C:\Users\SEU_USUARIO\Videos
MUSIC_ROOT=C:\Users\SEU_USUARIO\Music
# também onde mora o _Inbox e a pasta Softwares/Instaladores
DESKTOP_ROOT=C:\Users\SEU_USUARIO\Desktop
INBOX_DIRNAME=_Inbox
# sem override, banco e logs vivem em %LOCALAPPDATA%\FileOrganizerAgent — fora
# das 5 raízes acima. Só defina DB_PATH/LOG_DIR se quiser outro lugar.
DB_PATH=
LOG_DIR=

# --- comportamento ---
MODE=auto
DRY_RUN=0
CONFIDENCE_MIN=0.75
WATCH_RECURSIVE=0
MAX_WORKERS=2
ALLOW_CROSS_VOLUME=0

# --- resource guard ---
THRESHOLD_CPU=70
THRESHOLD_RAM=80
THRESHOLD_GPU=60
THRESHOLD_VRAM=70
GPU_INDEX=0
RETRY_BUSY_MINUTES=120
RETRY_STARTUP_MINUTES=30
IDLE_LOOP_SECONDS=600
MAX_TENTATIVAS=8

# --- estabilidade ---
STABILITY_POLLS=3
STABILITY_INTERVAL=1.0
STABILITY_TIMEOUT=300

# --- LLM (Fase 3) ---
# Gere a chave em https://aistudio.google.com/apikey (tier gratuito).
LLM_ENABLED=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TIMEOUT=30
LLM_SAMPLES=1

# --- busca (Fase 4) ---
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
SEARCH_RERANK_LLM=0
